# Docker Compose project and host port overrides.
COMPOSE_PROJECT_NAME=orderflow
HOST_BIND_ADDRESS=127.0.0.1

ORDER_PORT=3001
INVENTORY_PORT=3002
PAYMENT_PORT=3003
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
REDIS_PORT=6379

# Local RabbitMQ credentials. Use only URI-unreserved characters because the
# same literal values initialize RabbitMQ and appear in the services' AMQP URL.
RABBITMQ_USER=orderflow
RABBITMQ_PASSWORD=orderflow-dev
